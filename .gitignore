node_modules/
web/node_modules/
dist/
*.log

# overlay/ is now a build artifact (see web/vite.config.ts outDir) — the
# React app in web/ is the source of truth. Regenerate with
# `npm run build:web` rather than hand-editing anything in here.
overlay/

# Secrets — never commit.
#
# Both of them: the root .env holds the game server's SERVICE key, and
# web/.env holds the loadout's build-time vars. The anon key in the latter is
# meant to be public (RLS is what protects the data, see sql/001_roster.sql),
# but the file is per-machine either way and committing it would hard-code one
# person's project into everybody's build.
.env
web/.env
web/.env.local

# Supabase CLI scratch — link state and downloaded schemas, not source.
supabase/.temp/
supabase/.branches/

# Player data — the roster and its snapshots. Real people's characters, and
# not something a repo should carry: DATA_DIR points a deployment at a volume.
data/

# Generated by `npm run bundle:edge`. Committed or not, they are build output —
# regenerate rather than hand-edit.
supabase/functions/character/_engine.js
supabase/functions/character/_content.json

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
