# Copy to .env for local use. This server runs on the streamer's own PC — see
# DEPLOY.md — so in the normal setup none of this is a "deployment secret" in
# the usual sense, it's just local config. The Fly/Docker fallback documented
# in DEPLOY.md (not the current plan) is the one case where these would become
# real host secrets, set with `fly secrets set KEY=value`.

# --- always set, even locally ------------------------------------------------

# The operator's key. EVERY write needs it: /content/*, /sprite*, /placements,
# /admin/roster/*, and every show-running command. Unset means those endpoints
# refuse to run rather than run open. Make it long and random.
ADMIN_SECRET=

# --- sessions ----------------------------------------------------------------
# Signs the viewer session cookie (used by POST /command when a caller is
# acting as a specific viewer rather than as the operator). Falls back to
# ADMIN_SECRET, then to a value generated at boot — which signs everyone out
# on every restart. Set it.
SESSION_SECRET=

# "1" lets POST /session mint a session for any claimed id — the only way to
# get a viewer session today, now that Twitch OAuth for this server is gone
# (the loadout authenticates against Supabase directly, not this server; see
# AGENTS.md §3 and web/src/loadout/identity.ts). LOCAL DEV ONLY: it lets
# anyone pick whose character to edit. Leave unset unless you're testing.
ALLOW_DEV_LOGIN=

# --- storage -----------------------------------------------------------------
# Where the roster lives when Supabase is not configured. Defaults to ./data
# (gitignored) if unset, which is fine for local use — only set this to point
# at a mounted volume under the Fly/Docker fallback.
DATA_DIR=

# "file" keeps the roster in DATA_DIR even with Supabase configured below, so
# content still comes from the store and characters do not go to it. For
# testing: simulated joins create characters, and they should not land beside
# real viewers. Leave unset for a real stream.
ROSTER_STORE=

# Set BOTH to sync the roster with Supabase instead of a file — required if
# you want the hosted loadout and this server to share characters (see
# DEPLOY.md). Run sql/001_roster.sql first. The SECRET key (sb_secret_…, or
# the legacy service_role JWT) — not the publishable one, and it must never
# reach a browser.
#
# THE LOADOUT NEEDS ITS OWN PAIR, and they are not these. web/.env carries
# VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY, which Vite inlines into the
# browser bundle — see web/.env.example. Same project, different key, opposite
# trust level. `npm run check:supabase` verifies both halves at once and says
# which one is wrong.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- optional ----------------------------------------------------------------
# Comma-separated. Empty means same-origin only, which is the normal setup
# where this server also serves the pages.
ALLOWED_ORIGINS=

# --- only relevant under the Fly/Docker fallback (see DEPLOY.md) ------------
# Does nothing while this server runs locally at http://localhost:8787, which
# is the current architecture. This server has no OAuth flow of its own any
# more (the loadout signs viewers in against Supabase directly), so
# PUBLIC_ORIGIN's only remaining job is deciding whether the viewer-session
# cookie is marked Secure — meaningful only if this is ever put behind HTTPS
# via the documented fallback.
PUBLIC_ORIGIN=

# --- CHAT_SECRET -------------------------------------------------------------
# The shared secret a chat bot (Streamer.bot, or anything that can POST) sends
# as X-Chat-Secret on POST /chat and POST /redeem. Unset means chat commands are REFUSED with a
# 503 rather than accepted anonymously — a stream that forgot to set it should
# fail on the first message, not quietly take orders from strangers all night.
#
# Anyone holding this can act as any viewer, because the bot reports the viewer
# id and this server takes it on trust: the bot has already authenticated them
# against Twitch, and re-doing that here would mean running OAuth on this
# process again. Treat it like ADMIN_SECRET — same blast radius for viewers.
# See src/server/chat.ts.
CHAT_SECRET=
